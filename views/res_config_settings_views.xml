<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kafka.producer</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Kafka Producer" string="Kafka Producer" name="wb_data_kafka_producer_engine">
                    <block title="Kafka Cluster Configuration" name="kafka_cluster_config">
                        <setting string="Kafka Broker Servers" help="Bootstrap servers for the Kafka cluster (e.g. kafka.wonderbrands.site:9092).">
                            <field name="kafka_producer_broker_servers" placeholder="e.g. kafka.wonderbrands.site:9092"/>
                        </setting>
                        <setting string="Accepted Origin URLs" help="Comma-separated list of allowed origin URLs (e.g. https://somosreyes.odoo.com, http://localhost:8070). Publishing is skipped if current origin does not match.">
                            <field name="kafka_producer_accepted_origin" placeholder="https://somosreyes.odoo.com, http://localhost:8070"/>
                        </setting>
                        <setting string="Authentication Mechanism" help="Select authentication mechanism: AWS IAM, Redpanda/SASL SCRAM, or Plaintext.">
                            <field name="kafka_producer_auth_type"/>
                        </setting>
                    </block>

                    <block title="AWS MSK IAM Authentication" name="kafka_msk_config" invisible="kafka_producer_auth_type != 'aws_iam'">
                        <setting string="AWS Region" help="The region where your MSK cluster resides.">
                            <field name="kafka_producer_aws_region"/>
                        </setting>
                        <setting string="AWS Access Key" help="Access Key ID for IAM authentication.">
                            <field name="kafka_producer_aws_access_key_id"/>
                        </setting>
                        <setting string="AWS Secret Key" help="Secret Access Key for IAM authentication.">
                            <field name="kafka_producer_aws_secret_access_key" password="True"/>
                        </setting>
                    </block>

                    <block title="SASL / SCRAM Authentication (Redpanda / Confluent)" name="kafka_sasl_config" invisible="kafka_producer_auth_type != 'sasl_scram'">
                        <setting string="SASL Username" help="Kafka or Redpanda username (e.g. admin).">
                            <field name="kafka_producer_sasl_username" placeholder="admin"/>
                        </setting>
                        <setting string="SASL Password" help="Password for the SASL user.">
                            <field name="kafka_producer_sasl_password" password="True"/>
                        </setting>
                        <setting string="SASL Mechanism" help="SCRAM mechanism (SCRAM-SHA-256 recommended).">
                            <field name="kafka_producer_sasl_mechanism"/>
                        </setting>
                        <setting string="Security Protocol" help="Security protocol (SASL_SSL recommended for TLS).">
                            <field name="kafka_producer_security_protocol"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_kafka_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'wb_data_kafka_producer_engine'}</field>
    </record>

    <menuitem id="menu_kafka_config_settings"
        name="Settings"
        parent="wb_data_kafka_producer"
        action="action_kafka_config_settings"
        sequence="100"/>
</odoo>
