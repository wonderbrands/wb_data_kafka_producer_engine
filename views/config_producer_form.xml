<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="config_producer_view_form" model="ir.ui.view">
            <field name="name">config_producer.view.form</field>
            <field name="model">kafka.config</field>
            <field name="arch" type="xml">
                <form string="Configure listener">
                    <sheet>
                        <h1>
                            <label for="bootstrap_server">URL</label>
                            <field name="bootstrap_server" />
                        </h1>
                        <group>
                            <field name="description" />
                            <field name="is_ssl" />
                            <field name="ssl_ca_attachment_id" />
                            <field name="ssl_cert_attachment_id" />
                            <field name="ssl_key_attachment_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
