<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="followed_fields_view_form" model="ir.ui.view">
            <field name="name">followed_fields.view.form</field>
            <field name="model">model.follow</field>
            <field name="arch" type="xml">
                <form string="Followed Fields">
                    <sheet>
                        <h1>
                            <label for="model" string="Model" />
                            <field name="model" />
                        </h1>
                        <group>
                            <field name="topic" />
                            <field name="kafka_config_id" />
                        </group>
                        <notebook>
                            <page name="fields" string="Fields">
                                <field name="fields_related" no_create="1" domain = "[('model', '=', model)]">
                                    <tree >
                                        <field name="name" />
                                        <field name="follow_on_create" />
                                        <field name="follow_on_update" />
                                        <field name="follow_on_delete" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>    
</odoo>
