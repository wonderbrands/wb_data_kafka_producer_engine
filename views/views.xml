<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_data_kafka_producer_followed_fields_list_view" model="ir.ui.view">
        <field name="name">wb_data_kafka_producer_followed_fields_list_view</field>
        <field name="model">followed.model</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="model" />
            </list>
        </field>
    </record>

    <record id="wb_data_kafka_producer_followed_fields_form_view" model="ir.ui.view">
        <field name="name">wb_data_kafka_producer_followed_fields_form_view</field>
        <field name="model">followed.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model" />
                    </group>
                    <group name="bootstrap_servers" string="Bootstrap Servers">
                        <field name="use_uniques_bss" />
                        <field name="bootstrap_servers" />  
                    </group>
                    <group name="data" string="Data like">
                        <field name="api_like" />
                        <field name="schema_like" />
                        <field name="exclude_binary" />
                    </group>
                    <group name="computed_fields" string="Followed Computed Fields">
                        <field name="computed_fields">
                            <list editable="bottom">
                                <field name="field_id" domain="[('model_id', '=', parent.model)]" options="{'no_create': True}"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_data_kafka_producer_sends_log_list_view" model="ir.ui.view">
        <field name="name">wb_data_kafka_producer_sends_log_list_view</field>
        <field name="model">kafka.message.handler</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_retry" 
                            type="object" 
                            string="Retry not sent" 
                            class="btn-primary"
                            display="always"  />
                </header>
                <field name="operation_type" />
                <field name="topic" />
                <field name="message" />
                <field name="sent_status" />
                <field name="sent_date" />
                <field name="error_message" />
            </list>
        </field>
    </record>

    <record id="wb_data_kafka_producer_dump" model="ir.ui.view">
        <field name="name">wb_data_kafka_producer_dump</field>
        <field name="model">dump</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="model" />
                <field name="start_id" />
                <field name="end_id" />
                <field name="progress" widget="dump_progress_bar" />
                <field name="total" />
            </list>
        </field>
    </record>

    <record id="wb_data_kafka_producer_dump_form" model="ir.ui.view">
        <field name="name">wb_data_kafka_producer_dump_form</field>
        <field name="model">dump</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model" />
                        <field name="start_id" />
                        <field name="end_id" />
                    </group>
                    <group name="data" string="Data like">
                        <field name="api_like" />
                        <field name="schema_like" />
                    </group>
                    <group>
                        <field name="progress" widget="dump_progress_bar" />
                        <field name="total" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
